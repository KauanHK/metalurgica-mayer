# .env da RAIZ — lido pelo docker compose. Copie para `.env` antes do primeiro
# `docker compose up`:
#
#     cp .env.example .env
#
# Não é o mesmo arquivo que `backend/.env`: este alimenta os containers (inclusive
# o próprio Postgres, que usa POSTGRES_* para criar o banco na primeira subida).

COMPOSE_PROJECT_NAME=metalurgica-mayer

# Banco. POSTGRES_USER/PASSWORD/DB criam o banco no primeiro `up` — mudá-los
# depois NÃO recria nada, porque o volume já existe (ver README).
POSTGRES_DB=metalurgica_mayer
POSTGRES_USER=metalurgica
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Gere o seu com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MIN=30
REFRESH_TOKEN_EXPIRES_DAYS=7

# Usuário administrador criado por `scripts/seed/initial_user.py`.
SEED_USER_NAME=Administrador
SEED_USER_EMAIL=admin@metalurgicamayer.com.br
SEED_USER_PASSWORD=admin123

# Frontend. É lida no build do Next e vai para o bundle do navegador: nunca
# ponha segredo em variável NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
