# .env do BACKEND. As settings usam extra="forbid": uma chave a mais aqui
# derruba a app na subida. Por isso o .env da raiz (o do docker-compose) é um
# arquivo diferente deste — eles têm chaves diferentes.
#
# Rodando pelo docker compose, estas variáveis já vêm do .env da raiz e este
# arquivo só é necessário para rodar a API fora do container.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Fora do compose o host é localhost; dentro dele é `db` (o nome do serviço).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metalurgica_mayer
POSTGRES_USER=metalurgica
POSTGRES_PASSWORD=troque-esta-senha

# Origens liberadas no CORS, separadas por vírgula. O Next roda em :3000.
CORS_ORIGINS=http://localhost:3000

# Assina os tokens de sessão. Gere o seu com: openssl rand -hex 32
# Trocar este valor invalida todas as sessões abertas.
JWT_SECRET=troque-este-valor-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MIN=30
REFRESH_TOKEN_EXPIRES_DAYS=7
